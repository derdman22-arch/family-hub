# MongoDB Atlas connection string
# Create a free cluster at https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/family-hub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/family-hub?retryWrites=true&w=majority

# JWT signing secret — use a long random string (e.g. openssl rand -base64 32)
JWT_SECRET=replace-with-a-long-random-secret

# Port for the API server (optional, defaults to 5000)
PORT=5000

# Allowed origin for CORS (optional, defaults to http://localhost:3000)
CLIENT_ORIGIN=http://localhost:3000
