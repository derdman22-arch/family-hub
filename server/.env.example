# MongoDB Atlas connection string (direct, non-SRV format)
MONGODB_URI=mongodb://<user>:<password>@<host1>:27017,<host2>:27017,<host3>:27017/prod?ssl=true&replicaSet=<rs>&authSource=admin

# JWT signing secret — use a long random string (e.g. openssl rand -base64 32)
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth client — Cloud Console → APIs & Services → Credentials → your Web client.
# GOOGLE_CLIENT_ID must equal REACT_APP_GOOGLE_CLIENT_ID in the frontend.
# The client's "Authorized redirect URIs" must include <each CLIENT_ORIGIN>/auth/callback.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Encrypts stored Google refresh tokens. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it means everyone has to sign in again.
TOKEN_ENCRYPTION_KEY=

# The shared family calendar (Google Calendar → Settings → calendar → Calendar ID)
GOOGLE_CALENDAR_ID=primary

# Web Push keys — generate once with: npx web-push generate-vapid-keys
# Changing them invalidates every device's notification subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Allowed frontend origin(s), comma-separated (defaults to http://localhost:3000)
CLIENT_ORIGIN=http://localhost:3000

# Port for the API server (optional, defaults to 5000)
PORT=5000
