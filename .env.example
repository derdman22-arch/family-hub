# Google OAuth 2.0 Client ID
# Create at: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Type: Web application | Authorized JS origins: http://localhost:3000
REACT_APP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google Spreadsheet ID (from the sheet URL)
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
REACT_APP_SPREADSHEET_ID=1nln0UH69uKDCvPDmlHPUnQcLWacV7hzoiciFeWlWpG0

# Finnhub API key — free tier: https://finnhub.io
REACT_APP_FINNHUB_API_KEY=your-finnhub-api-key

# Google Calendar ID to display (defaults to "primary" if omitted)
# Use a specific calendar ID (e.g. a shared family calendar) from Google Calendar settings
REACT_APP_GOOGLE_CALENDAR_ID=primary

# 4-digit PIN to lock the Finance/Portfolio page (leave blank to disable the lock)
REACT_APP_FINANCE_PIN=
